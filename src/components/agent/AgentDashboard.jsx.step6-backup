import React, { useState, useMemo } from 'react';
import { useApp } from '../../context/AppContext';
import { PropertyCard } from '../properties/PropertyCard';
import { PropertyDetailsModal } from '../properties/PropertyDetailsModal';
import { StatusBadge, TypeBadge } from '../common/Badge';
import { formatCurrency, formatDate } from '../../utils/formatters';
import { Link } from 'react-router-dom';
import {
  Briefcase,
  Building,
  Calendar,
  Clock,
  User,
  Phone,
  Mail,
  Star,
  CheckCircle2,
  XCircle,
  Award,
  LogOut,
  ExternalLink,
  MessageSquare,
  Home,
  ShieldCheck,
  Edit2,
} from 'lucide-react';

export const AgentDashboard = () => {
  const {
    currentUser,
    logout,
    properties,
    bookings,
    agents,
    updateBookingStatus,
    updateProperty,
    setSelectedProperty,
    addToast,
  } = useApp();

  const [activeTab, setActiveTab] = useState('bookings'); // 'bookings' | 'properties' | 'profile'
  const [bookingFilter, setBookingFilter] = useState('All');

  // Find linked agent profile from actual database records
  const agentProfile = useMemo(() => {
    return agents.find(
      (a) =>
        a.email?.toLowerCase() === currentUser?.email?.toLowerCase() ||
        a.id === currentUser?.agent_id
    ) || {};
  }, [agents, currentUser]);

  // Strictly filter properties: ONLY assigned to this agent
  const myAssignedProperties = useMemo(() => {
    const agentId = agentProfile.id || currentUser?.agent_id;
    return properties.filter(
      (p) =>
        p.agent_id === agentId
    );
  }, [properties, agentProfile, currentUser]);

  // Strictly filter bookings: ONLY bookings for this agent's properties or directly assigned
  const myBookings = useMemo(() => {
    const assignedPropIds = new Set(myAssignedProperties.map((p) => p.id));
    const agentId = agentProfile.id || currentUser?.agent_id;

    return bookings.filter((b) => {
      const isAssignedDirectly = b.agent_id === agentId;
      const isForMyProperty = assignedPropIds.has(b.property_id);
      return isAssignedDirectly || isForMyProperty;
    });
  }, [bookings, myAssignedProperties, agentProfile, currentUser]);

  const filteredBookings = useMemo(() => {
    if (bookingFilter === 'All') return myBookings;
    return myBookings.filter((b) => b.status.toLowerCase() === bookingFilter.toLowerCase());
  }, [myBookings, bookingFilter]);

  // Status counts for this broker
  const pendingCount = myBookings.filter((b) => b.status === 'Pending').length;
  const approvedCount = myBookings.filter((b) => b.status === 'Approved').length;
  const completedCount = myBookings.filter((b) => b.status === 'Completed').length;

  const handleUpdateListingStatus = async (propertyId, newStatus) => {
    try {
      await updateProperty(propertyId, { availability: newStatus });
      addToast({
        type: 'success',
        title: 'Listing Status Updated',
        message: `Property marked as ${newStatus}.`,
      });
    } catch {
      addToast({ type: 'error', title: 'Error', message: 'Failed to update property status.' });
    }
  };

  return (
    <div className="min-h-screen bg-slate-50 py-8 sm:py-12">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Agent Workspace Top Bar */}
        <div className="bg-slate-900 text-white rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative overflow-hidden">
          <div className="absolute top-0 right-0 w-80 h-80 rounded-full bg-emerald-600/10 blur-3xl pointer-events-none" />

          <div className="flex items-center gap-4 relative z-10">
            <div className="relative">
              <img
                src={agentProfile.photo || currentUser?.avatar}
                alt={agentProfile.name}
                className="w-18 h-18 sm:w-20 sm:h-20 rounded-2xl object-cover border-2 border-amber-400/50 shadow-md"
              />
              <span className="absolute -bottom-1 -right-1 p-1 rounded-full bg-slate-950 text-amber-400 border border-amber-400/50">
                <ShieldCheck className="w-3.5 h-3.5" />
              </span>
            </div>

            <div>
              <div className="flex items-center gap-2">
                <span className="text-[10px] uppercase font-bold tracking-widest px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                  Licensed Broker Workspace
                </span>
              </div>
              <h1 className="text-2xl sm:text-3xl font-extrabold text-white mt-1">
                {agentProfile.name}
              </h1>
              <p className="text-xs text-amber-400 font-semibold mt-0.5">
                {agentProfile.specialty}
              </p>
              <div className="flex flex-wrap items-center gap-3 text-xs text-slate-300 mt-2">
                <span className="flex items-center gap-1">
                  <Award className="w-3.5 h-3.5 text-slate-400" />
                  {agentProfile.experience}
                </span>
                <span>â€¢</span>
                <span className="flex items-center gap-1 text-amber-400 font-bold">
                  <Star className="w-3.5 h-3.5 fill-amber-400" />
                  {agentProfile.rating ?? '—'}
                </span>
                <span>â€¢</span>
                <span>{agentProfile.deals_closed ?? 0} Transactions</span>
              </div>
            </div>
          </div>

          <div className="flex items-center gap-3 relative z-10 w-full md:w-auto justify-end">
            <Link
              to="/"
              className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-xl transition-all flex items-center gap-1.5"
            >
              <Home className="w-3.5 h-3.5" />
              <span>Public Showcase</span>
            </Link>

            <button
              onClick={logout}
              className="px-4 py-2 bg-rose-950/60 hover:bg-rose-900 border border-rose-500/30 text-rose-300 text-xs font-bold rounded-xl transition-all flex items-center gap-1.5 cursor-pointer"
            >
              <LogOut className="w-3.5 h-3.5" />
              <span>Sign Out</span>
            </button>
          </div>
        </div>

        {/* Broker KPI Metrics */}
        <div className="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div className="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-xs">
            <span className="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">
              Assigned Properties
            </span>
            <div className="text-2xl font-black text-slate-900 mt-1">
              {myAssignedProperties.length}
            </div>
            <span className="text-[11px] text-emerald-700 font-semibold mt-0.5 block">
              Active Listings
            </span>
          </div>

          <div className="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-xs">
            <span className="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">
              Pending Tour Requests
            </span>
            <div className="text-2xl font-black text-amber-600 mt-1">{pendingCount}</div>
            <span className="text-[11px] text-slate-500 mt-0.5 block">Requires Approval</span>
          </div>

          <div className="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-xs">
            <span className="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">
              Approved Tours
            </span>
            <div className="text-2xl font-black text-blue-600 mt-1">{approvedCount}</div>
            <span className="text-[11px] text-slate-500 mt-0.5 block">Scheduled</span>
          </div>

          <div className="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-xs">
            <span className="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">
              Completed Walkthroughs
            </span>
            <div className="text-2xl font-black text-slate-900 mt-1">{completedCount}</div>
            <span className="text-[11px] text-emerald-600 font-semibold mt-0.5 block">
              Client Inspected
            </span>
          </div>
        </div>

        {/* Tab Navigation */}
        <div className="mt-8 border-b border-slate-200 flex gap-6">
          <button
            onClick={() => setActiveTab('bookings')}
            className={`pb-3 text-sm font-bold border-b-2 transition-all cursor-pointer flex items-center gap-2 ${
              activeTab === 'bookings'
                ? 'border-amber-500 text-slate-900'
                : 'border-transparent text-slate-400 hover:text-slate-700'
            }`}
          >
            <Calendar className="w-4 h-4" />
            <span>Assigned Tour Bookings ({myBookings.length})</span>
          </button>

          <button
            onClick={() => setActiveTab('properties')}
            className={`pb-3 text-sm font-bold border-b-2 transition-all cursor-pointer flex items-center gap-2 ${
              activeTab === 'properties'
                ? 'border-amber-500 text-slate-900'
                : 'border-transparent text-slate-400 hover:text-slate-700'
            }`}
          >
            <Building className="w-4 h-4" />
            <span>My Assigned Listings ({myAssignedProperties.length})</span>
          </button>
        </div>

        {/* Tab Content */}
        <div className="mt-6">
          {activeTab === 'bookings' ? (
            /* Assigned Bookings Section */
            <div className="space-y-4">
              {/* Filter pills */}
              <div className="flex flex-wrap gap-2 p-1 bg-white rounded-2xl border border-slate-200/80 w-fit">
                {['All', 'Pending', 'Approved', 'Completed', 'Rejected'].map((status) => (
                  <button
                    key={status}
                    onClick={() => setBookingFilter(status)}
                    className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer ${
                      bookingFilter === status
                        ? 'bg-slate-900 text-amber-400 shadow-xs'
                        : 'text-slate-600 hover:text-slate-900'
                    }`}
                  >
                    {status}
                  </button>
                ))}
              </div>

              {filteredBookings.length === 0 ? (
                <div className="bg-white rounded-3xl p-12 text-center border border-slate-200/80">
                  <Calendar className="w-12 h-12 text-slate-300 mx-auto mb-3" />
                  <h3 className="text-base font-bold text-slate-900">No bookings in this category</h3>
                  <p className="text-xs text-slate-500 mt-1">
                    Client requests for your listings will be dispatched to this queue.
                  </p>
                </div>
              ) : (
                filteredBookings.map((b) => {
                  const prop = properties.find((p) => p.id === b.property_id);

                  return (
                    <div
                      key={b.id}
                      className="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-xs hover:shadow-md transition-all flex flex-col lg:flex-row lg:items-center justify-between gap-6"
                    >
                      <div className="flex items-start gap-4 min-w-0">
                        {prop ? (
                          <img
                            src={prop.image}
                            alt={prop.name}
                            className="w-20 h-20 rounded-2xl object-cover shrink-0 border border-slate-200 cursor-pointer"
                            onClick={() => setSelectedProperty(prop)}
                          />
                        ) : (
                          <div className="w-20 h-20 rounded-2xl bg-slate-100 flex items-center justify-center shrink-0">
                            <Building className="w-6 h-6 text-slate-400" />
                          </div>
                        )}

                        <div className="space-y-1 min-w-0">
                          <div className="flex items-center gap-2">
                            <span className="text-xs font-mono font-bold text-slate-400">
                              REF: {b.id.toUpperCase()}
                            </span>
                            <StatusBadge status={b.status} />
                          </div>

                          <h3
                            onClick={() => prop && setSelectedProperty(prop)}
                            className="text-base font-bold text-slate-900 hover:text-amber-700 cursor-pointer truncate"
                          >
                            {prop ? prop.name : `Property ID: ${b.property_id}`}
                          </h3>

                          <div className="flex flex-wrap items-center gap-3 text-xs text-slate-600">
                            <span className="flex items-center gap-1 font-semibold text-slate-800">
                              <Calendar className="w-3.5 h-3.5 text-amber-600" />
                              {formatDate(b.visit_date)}
                            </span>
                            <span>â€¢</span>
                            <span className="flex items-center gap-1">
                              <Clock className="w-3.5 h-3.5 text-slate-400" />
                              {b.time_slot || b.visit_time}
                            </span>
                          </div>

                          {/* Client Contact Info */}
                          <div className="flex flex-wrap items-center gap-3 pt-1 text-xs text-slate-500">
                            <span className="font-semibold text-slate-900 flex items-center gap-1">
                              <User className="w-3.5 h-3.5 text-slate-400" />
                              {b.customer_name}
                            </span>
                            <a
                              href={`mailto:${b.customer_email}`}
                              className="flex items-center gap-1 hover:text-amber-600 font-medium"
                            >
                              <Mail className="w-3.5 h-3.5 text-slate-400" />
                              {b.customer_email}
                            </a>
                            {b.customer_phone && (
                              <a
                                href={`tel:${b.customer_phone}`}
                                className="flex items-center gap-1 hover:text-amber-600 font-medium"
                              >
                                <Phone className="w-3.5 h-3.5 text-slate-400" />
                                {b.customer_phone}
                              </a>
                            )}
                          </div>

                          {b.notes && (
                            <p className="text-xs text-slate-500 italic mt-1 bg-slate-50 p-2 rounded-xl">
                              Client request: "{b.notes}"
                            </p>
                          )}
                        </div>
                      </div>

                      {/* Agent Tour Actions */}
                      <div className="flex flex-wrap items-center gap-2 border-t lg:border-t-0 pt-4 lg:pt-0 shrink-0">
                        {b.status === 'Pending' && (
                          <>
                            <button
                              onClick={() => updateBookingStatus(b.id, 'Approved', agentProfile.id)}
                              className="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 cursor-pointer"
                            >
                              <CheckCircle2 className="w-3.5 h-3.5" />
                              <span>Confirm Walkthrough</span>
                            </button>
                            <button
                              onClick={() => updateBookingStatus(b.id, 'Rejected', agentProfile.id)}
                              className="px-3.5 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer"
                            >
                              <XCircle className="w-3.5 h-3.5" />
                              <span>Decline</span>
                            </button>
                          </>
                        )}

                        {b.status === 'Approved' && (
                          <button
                            onClick={() => updateBookingStatus(b.id, 'Completed', agentProfile.id)}
                            className="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 cursor-pointer"
                          >
                            <CheckCircle2 className="w-3.5 h-3.5" />
                            <span>Mark Tour Completed</span>
                          </button>
                        )}

                        {b.status === 'Completed' && (
                          <span className="text-xs font-semibold text-blue-700 bg-blue-50 px-3 py-1.5 rounded-xl border border-blue-200">
                            âœ“ Walkthrough Conducted
                          </span>
                        )}
                      </div>
                    </div>
                  );
                })
              )}
            </div>
          ) : (
            /* My Assigned Listings Section */
            <div className="space-y-6">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-base font-bold text-slate-900">
                    Portfolio Properties Managed by You
                  </h3>
                  <p className="text-xs text-slate-500 mt-0.5">
                    Update listing availability status and inspect architectural dossiers.
                  </p>
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {myAssignedProperties.map((prop) => (
                  <div
                    key={prop.id}
                    className="p-5 rounded-3xl bg-white border border-slate-200/80 shadow-xs flex flex-col justify-between"
                  >
                    <div>
                      <div className="relative aspect-[16/10] rounded-2xl overflow-hidden mb-3">
                        <img
                          src={prop.image}
                          alt={prop.name}
                          className="w-full h-full object-cover"
                        />
                        <div className="absolute top-2 left-2 flex gap-1.5">
                          <TypeBadge type={prop.type} className="bg-white/95" />
                        </div>
                        <div className="absolute top-2 right-2">
                          <StatusBadge status={prop.availability} className="bg-white/95" />
                        </div>
                      </div>

                      <h4
                        onClick={() => setSelectedProperty(prop)}
                        className="text-sm font-bold text-slate-900 hover:text-amber-700 cursor-pointer line-clamp-1"
                      >
                        {prop.name}
                      </h4>
                      <p className="text-xs text-slate-500 mt-0.5">{prop.location}</p>

                      <div className="mt-2 text-base font-extrabold text-slate-900">
                        {formatCurrency(prop.price)}
                      </div>
                    </div>

                    {/* Agent Listing Controls */}
                    <div className="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
                      <select
                        value={prop.availability}
                        onChange={(e) => handleUpdateListingStatus(prop.id, e.target.value)}
                        className="px-2.5 py-1.5 rounded-xl border border-slate-200 text-xs font-semibold bg-slate-50 text-slate-700 focus:outline-none cursor-pointer"
                      >
                        <option value="Available">Available</option>
                        <option value="Under Offer">Under Offer</option>
                        <option value="Sold">Sold</option>
                        <option value="Rented">Rented</option>
                      </select>

                      <button
                        type="button"
                        onClick={() => setSelectedProperty(prop)}
                        className="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold flex items-center gap-1 cursor-pointer"
                      >
                        <ExternalLink className="w-3.5 h-3.5" />
                        <span>View Dossier</span>
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      <PropertyDetailsModal />
    </div>
  );
};



